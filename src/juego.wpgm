import wollok.game.*
import piezas.*

program juego {

    game.width(8)
    game.height(8)
    game.cellSize(50)
    game.title("Ajedrez")
    game.boardGround("tablero4.png")
    
    //agregado de piezas
    game.addVisual(torreNegroIzquierdo)
    game.addVisual(caballoNegroIzquierdo)
    game.addVisual(alfilNegroIzquierdo)
    game.addVisual(reinaNegro)
    game.addVisual(reyNegro)
    game.addVisual(alfilNegroDerecho)
    game.addVisual(caballoNegroDerecho)
    game.addVisual(torreNegroDerecho)
    game.addVisual(peonNegro0)
    game.addVisual(peonNegro1)
    game.addVisual(peonNegro2)
    game.addVisual(peonNegro3)
    game.addVisual(peonNegro4)
    game.addVisual(peonNegro5)
    game.addVisual(peonNegro6)
    game.addVisual(peonNegro7)

    game.addVisual(torreBlancoIzquierdo)
    game.addVisual(caballoBlancoIzquierdo)
    game.addVisual(alfilBlancoIzquierdo)
    game.addVisual(reinaBlanco)
    game.addVisual(reyBlanco)
    game.addVisual(alfilBlancoDerecho)
    game.addVisual(caballoBlancoDerecho)
    game.addVisual(torreBlancoDerecho)
    game.addVisual(peonBlanco0)
    game.addVisual(peonBlanco1)
    game.addVisual(peonBlanco2)
    game.addVisual(peonBlanco3)
    game.addVisual(peonBlanco4)
    game.addVisual(peonBlanco5)
    game.addVisual(peonBlanco6)
    game.addVisual(peonBlanco7)
  


    
  game.start()
}








