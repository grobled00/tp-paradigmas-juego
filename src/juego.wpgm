import wollok.game.*
import piezas.*

program juego {

    game.width(8)
    game.height(8)
    game.cellSize(50)
    game.title("Ajedrez")
    game.boardGround("tablero4.png")
    
    //agregado de piezas
    
    // Torres
    const torreNegroIzquierdo = new Torre(position = game.at(0,0), color = "negro")
    game.addVisual(torreNegroIzquierdo)
    const torreNegroDerecho = new Torre(position = game.at(7,0), color = "negro")
    game.addVisual(torreNegroDerecho)
    const torreBlancoDerecho = new Torre(position = game.at(7, 7), color = "blanco")
    game.addVisual(torreBlancoDerecho)
    const torreBlancoIzquierdo = new Torre(position = game.at(0, 7), color = "blanco")
    game.addVisual(torreBlancoIzquierdo)
    // Caballos
    const caballoNegroIzquierdo = new Caballo(position = game.at(1,0), color = "negro")
    game.addVisual(caballoNegroIzquierdo)
    const cabelloNegroDerecho = new Caballo(position = game.at(6,0), color = "negro")
    game.addVisual(cabelloNegroDerecho)
    const caballoBlancoIzquierdo = new Caballo(position = game.at(1,7), color = "blanco")
    game.addVisual(caballoBlancoIzquierdo)
    const caballoBlancoDerecho = new Caballo(position = game.at(6,7), color = "blanco")
    game.addVisual(caballoBlancoDerecho)
    //Alfiles
    const alfilNegroIzquierdo = new Alfil(position = game.at(2,0), color = "negro")
    game.addVisual(alfilNegroIzquierdo)
    const alfilNegroDerecho = new Alfil(position = game.at(5,0), color = "negro")
    game.addVisual(alfilNegroDerecho)
    const alfilBlancoIzquierdo = new Alfil(position = game.at(2,7), color = "blanco")
    game.addVisual(alfilBlancoIzquierdo)
    const alfilBlancoDerecho = new Alfil(position = game.at(5,7), color = "blanco")
    game.addVisual(alfilBlancoDerecho)
    //Reyes
    const reyBlanco = new Rey(position = game.at(3,7), color = "blanco")
    game.addVisual(reyBlanco)
    const reinaBlanco = new Reina(position = game.at(4,7), color = "blanco")
    game.addVisual(reinaBlanco)
    const reyNegro = new Rey(position = game.at(3,0), color = "negro")
    game.addVisual(reyNegro)
    const reinaNegro = new Reina(position = game.at(4,0), color = "negro")
    game.addVisual(reinaNegro)
    // Peones
    const peonNegro0 = new Peon(position = game.at(0,1), color = "negro")
    game.addVisual(peonNegro0)
    const peonNegro1 = new Peon(position = game.at(1,1), color = "negro")
    game.addVisual(peonNegro1)
    const peonNegro2 = new Peon(position = game.at(2,1), color = "negro")
    game.addVisual(peonNegro2)
    const peonNegro3 = new Peon(position = game.at(3,1), color = "negro")
    game.addVisual(peonNegro3)
    const peonNegro4 = new Peon(position = game.at(4,1), color = "negro")
    game.addVisual(peonNegro4)
    const peonNegro5 = new Peon(position = game.at(5,1), color = "negro")
    game.addVisual(peonNegro5)
    const peonNegro6 = new Peon(position = game.at(6,1), color = "negro")
    game.addVisual(peonNegro6)
    const peonNegro7 = new Peon(position = game.at(7,1), color = "negro")
    game.addVisual(peonNegro7)
    // Peones blancos
    const peonBlanco0 = new Peon(position = game.at(0,6), color = "blanco")
    game.addVisual(peonBlanco0)
    const peonBlanco1 = new Peon(position = game.at(1,6), color = "blanco")
    game.addVisual(peonBlanco1)
    const peonBlanco2 = new Peon(position = game.at(2,6), color = "blanco")
    game.addVisual(peonBlanco2)
    const peonBlanco3 = new Peon(position = game.at(3,6), color = "blanco")
    game.addVisual(peonBlanco3)
    const peonBlanco4 = new Peon(position = game.at(4,6), color = "blanco")
    game.addVisual(peonBlanco4)
    const peonBlanco5 = new Peon(position = game.at(5,6), color = "blanco")
    game.addVisual(peonBlanco5)
    const peonBlanco6 = new Peon(position = game.at(6,6), color = "blanco")
    game.addVisual(peonBlanco6)
    const peonBlanco7 = new Peon(position = game.at(7,6), color = "blanco")
    game.addVisual(peonBlanco7)
    
  game.start()
}








